# ============================================================
# SMARTDEPT Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/smartdept_db

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_secure_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- OTP Settings ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email (SMTP) ---
# Use Gmail App Passwords, Outlook, SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_college_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=SmartDept <no-reply@smartdept.edu>

# --- College Domain Whitelist ---
# Comma-separated list of allowed email domains
ALLOWED_DOMAINS=gmail.com,college.edu,students.college.edu

# --- App ---
APP_NAME=SmartDept
FRONTEND_URL=http://localhost:5173
DEBUG=True
